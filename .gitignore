# Checkpoints: ~39G and growing, regenerable from the code plus the datasets.
# The eval JSON/CSV/PNG sitting next to them is 8 MB and IS the result, so it
# stays tracked - that is the part a paper is written from and the part that
# cannot be regenerated without spending the GPU time again.
*.ckpt
logs/

# Datasets, downloaded from robomimic / diffusion-policy. See HANDOFF.md for
# the URLs -- and for why the robomimic ones must come from the legacy path,
# not the official download script.
env/*/data/
env/robomimic/_dl/

# Environment and build artefacts
.venv/
__pycache__/
*.pyc
cl_sfp.egg-info/

# Migration scratch (checksums, manifests)
migrate/

# Agent tooling state
algo/.omc/

# Per-machine Claude Code permissions, not shared
.claude/settings.local.json
